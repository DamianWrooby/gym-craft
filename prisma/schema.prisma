generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model User {
    id                   String              @id @default(uuid())
    username             String              @unique
    email                String              @default("") @db.VarChar(50)
    emailVerified        Boolean             @default(false)
    marketingAgreement   Boolean             @default(false)
    passwordHash         String
    userAuthToken        String              @unique
    createdAt            DateTime            @default(now())
    updatedAt            DateTime            @updatedAt
    roleId               Int
    role                 Roles               @relation(fields: [roleId], references: [id])
    generatedPlansNumber Int                 @default(0)
    subscriptionTier     SubscriptionTier    @default(FREE)
    stripeCustomerId     String?             @unique
    stripeSubscriptionId String?
    subscriptionStatus   String?
    currentPeriodEnd     DateTime?
    // Account-wide AI model setting; null = tier default. Resolved per request (ADR 0016).
    aiModelPreference    String?
    plans                Plan[]
    planWeeks            PlanWeek[]
    raceResults          RaceResult[]
    plannedSessions      PlannedSession[]
    aiRequests           AiRequest[]
    verificationTokens   VerificationToken[]
    garminData           GarminData?
    athleteProfile       AthleteProfile?
    runningGoals         RunningGoal[]
    trainingReports      TrainingReport[]
    activities           Activity[]
    garminSyncState      GarminSyncState?
    aiUsage              AiUsage[]

    @@index([roleId])
}

model Roles {
    id   Int    @id @default(autoincrement())
    name Role   @unique
    User User[]
}

// A bounded horizon working toward one goal (ADRs 0008, 0012). One ACTIVE plan per user,
// enforced by a partial unique index in the migration. Table name avoids the legacy "Plan".
model Plan {
    id           String      @id @default(uuid())
    userId       String
    goalId       String
    startDate    DateTime    @db.Date
    endDate      DateTime    @db.Date
    state        PlanState   @default(ACTIVE)
    // { mon: true, tue: false, ... } — the availability map.
    availability Json
    // 0 = Monday … 6 = Sunday.
    longRunDay   Int
    // How the athlete's data shaped the layout (PlanRationale), frozen at creation.
    rationale    Json?
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt
    User         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    goal         RunningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
    phases       PlanPhase[]

    @@index([userId, state])
    @@map("HorizonPlan")
}

enum PlanState {
    ACTIVE
    COMPLETED
    ABANDONED
}

model PlanPhase {
    id         String      @id @default(uuid())
    planId     String
    key        String
    name       String
    ordinal    Int
    startDate  DateTime    @db.Date
    endDate    DateTime    @db.Date
    intent     String
    source     PhaseSource
    // Training school id from the catalogue; stamped per phase so past phases keep theirs.
    school     String
    volumeUnit VolumeUnit
    plan       Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
    weeks      PlanWeek[]

    @@unique([planId, ordinal])
}

enum PhaseSource {
    SCHOOL
    LEAD_IN
}

enum VolumeUnit {
    MINUTES
    METRES
}

model PlanWeek {
    id                    String           @id @default(uuid())
    userId                String
    phaseId               String
    startDate             DateTime         @db.Date
    endDate               DateTime         @db.Date
    inHorizonDays         Int
    // Struck once at the pull and frozen (ADR 0011); null until then.
    recoveryBudget        Float?
    chronicLoad           Float?
    budgetStruckAt        DateTime?
    // Share of the chronic load costed at a flat rate or guessed (ADR 0011).
    chronicFallbackShare  Float?
    // Why no budget was struck; null when one was, or before the strike.
    budgetAbsence         BudgetAbsence?
    // The trim, ask or placement trim the finalize recorded (ADR 0013); null when nothing was cut.
    conflict              Json?
    // The athlete's answer to an ask; KEPT is the per-week override record.
    decision              WeekDecision?
    // Set by the athlete at the pull that writes this week.
    outlook               WeekOutlook?
    outlookFactor         Float?
    generation            WeekGeneration   @default(PENDING)
    isCutback             Boolean          @default(false)
    // Taper weeks count as recovery for the cutback cap (ADR 0021).
    isTaper               Boolean          @default(false)
    // Set on the week holding the time trial when no anchor existed at layout (ADR 0020).
    timeTrialDistanceM    Int?
    volumeTarget          Int
    volumeUnit            VolumeUnit
    strengthSessionTarget Int
    revision              Int              @default(0)
    revisedAt             DateTime?
    // The AI request that writes this week's sessions (ADR 0014); null until generation starts.
    aiRequestId           String?          @unique
    User                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    phase                 PlanPhase        @relation(fields: [phaseId], references: [id], onDelete: Cascade)
    aiRequest             AiRequest?       @relation(fields: [aiRequestId], references: [id], onDelete: SetNull)
    sessions              PlannedSession[]

    @@index([userId, startDate])
    @@index([phaseId])
}

enum BudgetAbsence {
    // No tracked activity at all: the athlete has not linked Garmin or never synced.
    NO_TRACKED_ACTIVITY
    // Under 28 days of history, or a chronic load of zero.
    SHORT_HISTORY
}

enum WeekDecision {
    PENDING
    DROPPED
    DOWNGRADED
    KEPT
}

enum WeekOutlook {
    NORMAL
    BUSY
    TRAVEL
    ILL
}

enum WeekGeneration {
    PENDING
    GENERATED
    FAILED
}

// One training session written onto a date (ADRs 0007, 0009). The body is per kind, typed in
// src/lib/planner/core/session.ts and versioned by bodyVersion.
model PlannedSession {
    id            String        @id @default(uuid())
    userId        String
    planWeekId    String
    kind          SessionKind
    scheduledDate DateTime      @db.Date
    sequence      Int           @default(0)
    status        SessionStatus @default(PLANNED)
    origin        SessionOrigin
    plannedLoad   Float
    loadMethod    LoadMethod
    activityId    String?
    supersedesId  String?
    // Anchor provenance behind the pace targets: { provenance, sourceId, date, stale } or null.
    anchor        Json?
    body          Json
    bodyVersion   Int           @default(1)
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt
    User          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    planWeek      PlanWeek      @relation(fields: [planWeekId], references: [id], onDelete: Cascade)

    @@index([planWeekId, scheduledDate])
    @@index([userId, scheduledDate])
}

enum SessionKind {
    STRENGTH
    RUNNING
    OTHER
}

enum SessionStatus {
    PLANNED
    DONE
    SKIPPED
    SUPERSEDED
}

enum SessionOrigin {
    AI
    ATHLETE
}

// One paid AI call, recorded before it is made (ADR 0014). Generic: the app writes the input and
// model, the proxy writes the output and status. Nothing here knows about plans.
model AiRequest {
    id         String          @id @default(uuid())
    userId     String
    model      String
    // { system, user, maxTokens } — the complete prompt, built by the app server.
    input      Json
    status     AiRequestStatus @default(PENDING)
    output     String?         @db.Text
    error      String?
    retryCount Int             @default(0)
    createdAt  DateTime        @default(now())
    updatedAt  DateTime        @updatedAt
    User       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    planWeek   PlanWeek?

    @@index([userId, status])
}

enum AiRequestStatus {
    PENDING
    RUNNING
    DONE
    FAILED
}

// Athlete-entered timed effort, 1500–42195 m (ADR 0010). Never inferred.
model RaceResult {
    id        String   @id @default(uuid())
    userId    String
    date      DateTime @db.Date
    distanceM Int
    timeSec   Int
    label     String?  @db.VarChar(100)
    createdAt DateTime @default(now())
    User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

enum Role {
    ADMIN
    MODERATOR
    USER
}

enum SubscriptionTier {
    FREE
    SUPPORTER
}

model Configuration {
    id        String   @id @default(uuid())
    name      String
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model VerificationToken {
    id        String    @id @default(uuid())
    userId    String
    tokenHash String    @unique
    expiresAt DateTime
    createdAt DateTime  @default(now())
    usedAt    DateTime?
    isUsed    Boolean   @default(false)

    User User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([tokenHash])
}

model GarminData {
    id           String  @id @default(uuid())
    userId       String  @unique
    email        String  @default("") @db.VarChar(50)
    // Opaque Garmin session token issued by the curl_cffi microservice's /authenticate.
    // Exchanged once for the user's Garmin password; sent as a Bearer token on all subsequent
    // Garmin calls so the email is no longer the identity. Nullable until the user first signs in.
    sessionToken String?
    User         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model AthleteProfile {
    id           String   @id @default(uuid())
    userId       String   @unique
    birthDate    DateTime
    sex          Sex
    weightKg     Decimal  @db.Decimal(5, 2)
    heightCm     Int
    timezone     String   @default("UTC")
    restingHR    Int?
    maxHR        Int?
    hrZoneBounds Json?
    vo2max       Decimal? @db.Decimal(4, 1)
    updatedAt    DateTime @updatedAt
    User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Sex {
    MALE
    FEMALE
    OTHER
}

model RunningGoal {
    id              String    @id @default(uuid())
    userId          String
    goalType        GoalType
    targetEventName String?
    targetEventDate DateTime?
    targetDistanceM Int?
    targetTimeSec   Int?
    notes           String?   @db.VarChar(500)
    priority        Int       @default(1)
    archivedAt      DateTime?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    User            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    plans           Plan[]

    @@index([userId])
}

enum GoalType {
    RACE
    GENERAL_FITNESS
    BASE_BUILDING
    TEMPO_WORK
    RECOVERY
}

model TrainingReport {
    id              String     @id @default(uuid())
    userId          String
    type            ReportType
    periodStart     String     @db.VarChar(10)
    periodEnd       String     @db.VarChar(10)
    metrics         Json
    summary         String     @db.Text
    goalContext     Json
    createdAt       DateTime   @default(now())
    // Denormalized from metrics.loadProfile for cheap list/chart reads (ADR 0006).
    // Nullable: loadProfile is absent when computeLoadProfile throws at generation.
    acwrStatus      String?
    weeklyTotalLoad Float?
    monotonyIsHigh  Boolean?
    User            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, type, periodStart])
}

enum ReportType {
    WEEKLY
    MONTHLY
    MICROCYCLE
}

model Activity {
    id                String          @id @default(uuid())
    userId            String
    garminActivityId  BigInt
    activityType      String
    activityName      String?
    startTime         DateTime
    durationSec       Int
    movingDurationSec Int?
    distanceM         Float?
    calories          Int?
    averageHr         Int?
    maxHr             Int?
    hrZone1Sec        Int?
    hrZone2Sec        Int?
    hrZone3Sec        Int?
    hrZone4Sec        Int?
    hrZone5Sec        Int?
    moderateMinutes   Int?
    vigorousMinutes   Int?
    averageSpeed      Float?
    maxSpeed          Float?
    averageCadence    Float?
    maxCadence        Float?
    avgStrideLength   Float?
    elevationGainM    Float?
    elevationLossM    Float?
    trimpLoad         Float?
    loadMethod        LoadMethod?
    // Which zones scored a run; GARMIN_ZONES runs in the 42-day window are retried each sync.
    zoneSource        ZoneSource?
    raw               Json
    fetchedAt         DateTime        @default(now())
    User              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    detail            ActivityDetail?

    @@unique([userId, garminActivityId])
    @@index([userId, startTime(sort: Desc)])
    @@index([userId, activityType, startTime(sort: Desc)])
}

enum LoadMethod {
    EDWARDS
    BANISTER
    DURATION
    LABEL_TABLE
    ATHLETE_ESTIMATE
}

enum ZoneSource {
    ATHLETE_ZONES
    GARMIN_ZONES
}

model ActivityDetail {
    activityId    String   @id
    splits        Json
    samples       Json
    route         Json?
    dynamics      Json?
    schemaVersion Int      @default(1)
    raw           Json?
    fetchedAt     DateTime @default(now())
    Activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model AiUsage {
    id        String   @id @default(uuid())
    userId    String
    kind      String
    day       String   @db.VarChar(10)
    count     Int      @default(0)
    updatedAt DateTime @updatedAt
    User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, kind, day])
    @@index([userId, kind])
}

model GarminSyncState {
    userId           String    @id
    lastSyncedAt     DateTime?
    oldestActivityAt DateTime?
    backfillComplete Boolean   @default(false)
    updatedAt        DateTime  @updatedAt
    User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
