@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;
/*place global styles here */
html,
body {
    @apply h-full;
}
@layer base {
    body {
        @apply bg-gradient-to-tr from-slate-500 to-slate-300;
    }
    .dark body {
        @apply from-slate-900 to-slate-800;
        background-color: transparent;
    }
}
/* ---- Mobile layout ----
   Skeleton's AppShell pins the top bar and footer and scrolls only the content between
   them, which leaves little room for content on phones. Below md the whole document
   scrolls instead: the top bar and footer move with the page, and mobile browsers can
   collapse their own address bar as the user scrolls. */
@media (max-width: 767.98px) {
    html,
    body {
        height: auto;
        min-height: 100%;
    }
    #appShell {
        height: auto;
        min-height: 100vh;
        min-height: 100dvh;
        overflow: visible;
    }
    #appShell > .flex-auto,
    #appShell #page {
        height: auto;
        overflow: visible;
    }
    /* Overflow is no longer clipped by #page, so clip stray horizontal overflow here. */
    body {
        overflow-x: hidden;
    }
}

.list li {
    margin: 0;
    border-radius: 0;
}
.list li > :not([hidden]) ~ :not([hidden]) {
    margin: 0;
}
article.modal-body {
    max-height: unset;
}

/* ---- Motion (#235) ---- */
/* Page cross-fade, driven by setupViewTransitions() in the layouts. */
::view-transition-old(root) {
    animation: 160ms ease-in both vt-fade-out;
}
::view-transition-new(root) {
    animation: 260ms ease-out both vt-fade-in;
}
/* The top bar stays still while the page content changes. */
.app-bar {
    view-transition-name: app-bar;
}

@keyframes vt-fade-out {
    to {
        opacity: 0;
    }
}
@keyframes vt-fade-in {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
}

/* Page cards rise in on first render; buttons lift slightly on hover. */
.card-rise {
    animation: 320ms ease-out both card-rise;
}
@keyframes card-rise {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
}
.btn:not(:disabled) {
    transition:
        transform 150ms ease,
        filter 150ms ease;
}
.btn:not(:disabled):hover {
    transform: translateY(-1px);
}
.btn:not(:disabled):active {
    transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root),
    .card-rise {
        animation: none;
    }
    .btn:not(:disabled):hover {
        transform: none;
    }
}
